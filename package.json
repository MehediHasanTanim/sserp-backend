{
  "name": "sserp-backend",
  "version": "0.1.0",
  "description": "Special School & Therapy Center ERP — NestJS API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker.main",
    "start:worker:dev": "nest start --watch --entryFile worker.main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest --config ./jest.config.js --selectProjects unit",
    "test:unit": "jest --config ./jest.config.js --selectProjects unit",
    "test:integration": "jest --config ./jest.config.js --selectProjects integration --runInBand --testTimeout=120000",
    "test:int": "npm run test:integration",
    "test:cov": "jest --config ./jest.unit.config.js --coverage",
    "test:watch": "jest --config ./jest.config.js --watch",
    "test:mutation": "stryker run",
    "test:traceability": "ts-node --transpile-only scripts/traceability-coverage.ts",
    "test:report-coverage": "ts-node --transpile-only scripts/report-coverage-parity.ts",
    "test:openapi-routes": "ts-node --transpile-only scripts/openapi-route-coverage.ts openapi/openapi.json reports/route-coverage/routes.log",
    "semgrep": "bash scripts/run-semgrep.sh",
    "k6": "bash scripts/run-k6.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node --transpile-only prisma/seed/reference.seed.ts",
    "seed:dev": "ts-node --transpile-only prisma/seed/dev.seed.ts",
    "seed:e2e": "ts-node --transpile-only scripts/e2e-seed.ts",
    "seed:e2e:teardown": "ts-node --transpile-only scripts/e2e-teardown.ts",
    "user:create": "ts-node --transpile-only scripts/create-user.ts",
    "openapi:export": "ts-node --transpile-only scripts/export-openapi.ts",
    "openapi:check": "ts-node --transpile-only scripts/export-openapi.ts --check",
    "backup:pg": "bash scripts/backup-pg.sh",
    "backup:verify": "bash scripts/verify-backup.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "seed:volume": "ts-node --transpile-only scripts/volume-seed.ts",
    "encryption:backfill": "ts-node --transpile-only scripts/backfill-field-encryption.ts",
    "check:no-retry": "bash scripts/check-no-jest-retry.sh",
    "check:sensitive-fixtures": "bash scripts/check-sensitive-fixtures.sh"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "ts-node --transpile-only prisma/seed/reference.seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.69.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-security": "^4.0.1",
    "fishery": "^2.4.0",
    "jest": "^29.5.0",
    "jest-html-reporter": "^4.4.0",
    "jest-mock-extended": "^3.0.7",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
