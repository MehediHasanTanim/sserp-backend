model OrganizationSettings {
  id                        String   @id @db.Uuid
  name                      String
  logoObjectKey             String?  @map("logo_object_key")
  address                   String?
  phone                     String?
  email                     String?
  registrationDetails       Json?    @map("registration_details")
  currencyCode              String   @default("BDT") @map("currency_code")
  currencyMinorUnits        Int      @default(2) @map("currency_minor_units")
  timezone                  String   @default("Asia/Dhaka")
  sessionIdleTimeoutMinutes Int      @default(30) @map("session_idle_timeout_minutes")
  dateFormat                String   @default("dd/MM/yyyy") @map("date_format")
  fiscalYearStartMonth      Int      @default(7) @map("fiscal_year_start_month")
  /// Weekday numbers (0=Sun … 6=Sat) that are weekly offs. Default Fri–Sat.
  workingWeek               Json     @default("[5, 6]") @map("working_week")
  feeDueDayOfMonth          Int      @default(10) @map("fee_due_day_of_month")
  feeReminderDays           Json     @default("[3, 7, 15, 30]") @map("fee_reminder_days")
  discountApprovalThresholdPercent Int @default(10) @map("discount_approval_threshold_percent")
  portalMessageEnabled      Boolean  @default(true) @map("portal_message_enabled")
  dividendWithholdingTaxPercent Int @default(10) @map("dividend_withholding_tax_percent")
  defaultBudgetEnforcementMode String @default("warn") @map("default_budget_enforcement_mode")
  bankMatchDateWindowDays   Int      @default(3) @map("bank_match_date_window_days")
  gratuityLwpExclusionThresholdDays Int @default(30) @map("gratuity_lwp_exclusion_threshold_days")
  payrollDefaultWorkingDays Int      @default(22) @map("payroll_default_working_days")
  encashmentPerDayDivisor   Int      @default(30) @map("encashment_per_day_divisor")
  bankTransferFileFormat    BankTransferFileFormat @default(csv) @map("bank_transfer_file_format")
  poApprovalThreshold       Int      @default(5000000) @map("po_approval_threshold")
  invoiceVarianceTolerancePercent Int @default(2) @map("invoice_variance_tolerance_percent")
  grnOverDeliveryTolerancePercent Int @default(0) @map("grn_over_delivery_tolerance_percent")
  autoPrOnLowStockEnabled   Boolean  @default(false) @map("auto_pr_on_low_stock_enabled")
  defaultValuationMethod    ValuationMethod @default(weighted_average) @map("default_valuation_method")
  reportSyncTimeoutMs       Int      @default(5000) @map("report_sync_timeout_ms")
  exportMaxRows             Int      @default(200000) @map("export_max_rows")
  exportRetentionHours      Int      @default(24) @map("export_retention_hours")
  dashboardCacheTtlSeconds  Int      @default(600) @map("dashboard_cache_ttl_seconds")
  notificationQuietHoursDefaultStart String? @map("notification_quiet_hours_default_start")
  notificationQuietHoursDefaultEnd   String? @map("notification_quiet_hours_default_end")
  messageEditWindowMinutes           Int     @default(15) @map("message_edit_window_minutes")
  notificationDedupWindowSeconds     Int     @default(300) @map("notification_dedup_window_seconds")
  smsEnabled                         Boolean @default(true) @map("sms_enabled")
  emailEnabled                       Boolean @default(true) @map("email_enabled")
  /// Optional CIDR/IP allow list for super_admin routes (JSON string array).
  superAdminIpAllowlist              Json?   @map("super_admin_ip_allowlist")
  /// Comma-separated roles that require 2FA when logging in.
  twoFactorRequiredRoles             Json    @default("[\"super_admin\"]") @map("two_factor_required_roles")
  featureBiometricEnabled            Boolean @default(false) @map("feature_biometric_enabled")
  featurePaymentGatewayEnabled       Boolean @default(false) @map("feature_payment_gateway_enabled")
  /// Null = password expiry disabled.
  passwordMaxAgeDays                 Int?    @map("password_max_age_days")
  /// Minor units deducted per minute late after grace (0 = off).
  latePenaltyPerMinute               Int     @default(0) @map("late_penalty_per_minute")
  /// Minor units deducted per minute early leave after grace (0 = off).
  earlyLeavePenaltyPerMinute         Int     @default(0) @map("early_leave_penalty_per_minute")
  /// Consecutive late days before anomaly alert (0 = off).
  attendanceAnomalyLateStreakDays    Int     @default(0) @map("attendance_anomaly_late_streak_days")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
}

model NumberingScheme {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      String                @unique @map("entity_type")
  prefix          String
  padding         Int                   @default(4)
  currentSequence Int                   @default(0) @map("current_sequence")
  resetPeriod     NumberingResetPeriod  @default(never) @map("reset_period")
  lastResetAt     DateTime?             @map("last_reset_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@map("numbering_schemes")
}

model Attachment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket           String
  objectKey        String           @unique @map("object_key")
  originalFilename String           @map("original_filename")
  mimeType         String           @map("mime_type")
  sizeBytes        Int              @map("size_bytes")
  checksumSha256   String?          @map("checksum_sha256")
  entityType       String?          @map("entity_type")
  entityId         String?          @map("entity_id")
  uploadedBy       String           @map("uploaded_by") @db.Uuid
  status           AttachmentStatus @default(pending)
  createdAt        DateTime         @default(now()) @map("created_at")
  deletedAt        DateTime?        @map("deleted_at")

  uploader User @relation("UploadedBy", fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@index([status, createdAt])
  @@map("attachments")
}

model PendingLedgerPosting {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceType     String              @map("reference_type")
  referenceId       String              @map("reference_id")
  amount            Int
  costCenter        String              @map("cost_center")
  description       String
  debitAccountCode  String              @map("debit_account_code")
  creditAccountCode String              @map("credit_account_code")
  postingDate       DateTime            @map("posting_date") @db.Date
  payload           Json?
  status            LedgerPostingStatus @default(pending)
  postedJournalId   String?             @map("posted_journal_id") @db.Uuid
  errorMessage      String?             @map("error_message")
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([referenceType, referenceId])
  @@map("pending_ledger_postings")
}
