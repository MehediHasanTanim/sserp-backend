// Phase 4: Finance Module Schema

model Shareholder {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  shareholderType  ShareholderType   @map("shareholder_type")
  sharePercentage  Decimal           @map("share_percentage") @db.Decimal(7, 4)
  sharesCount      Int               @default(0) @map("shares_count")
  contactPhone     String?           @map("contact_phone")
  contactEmail     String?           @map("contact_email")
  address          String?
  taxIdentifier    String?           @map("tax_identifier")
  bankDetails      Json?             @map("bank_details") @db.Json
  joinedDate       DateTime          @map("joined_date") @db.Date
  exitedDate       DateTime?         @map("exited_date") @db.Date
  status           ShareholderStatus @default(active)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  transfersFrom    ShareTransfer[]   @relation("TransferFrom")
  transfersTo      ShareTransfer[]   @relation("TransferTo")
  disbursements    ProfitDisbursement[]

  @@map("shareholders")
}

model ShareTransfer {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromShareholderId    String       @map("from_shareholder_id") @db.Uuid
  toShareholderId      String?      @map("to_shareholder_id") @db.Uuid
  toName               String?      @map("to_name")
  percentageTransferred Decimal     @map("percentage_transferred") @db.Decimal(7, 4)
  transferDate         DateTime     @map("transfer_date") @db.Date
  considerationAmount  Int?         @map("consideration_amount")
  approvedBy           String       @map("approved_by") @db.Uuid
  attachmentId         String?      @map("attachment_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at")

  fromShareholder      Shareholder  @relation("TransferFrom", fields: [fromShareholderId], references: [id])
  toShareholder        Shareholder? @relation("TransferTo", fields: [toShareholderId], references: [id])

  @@map("share_transfers")
}

model ReserveFund {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  coaAccountId String         @map("coa_account_id") @db.Uuid
  description  String?
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  coaAccount   ChartOfAccount @relation(fields: [coaAccountId], references: [id])

  @@map("reserve_funds")
}

model ProfitAppropriation {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYear         String               @map("fiscal_year")
  netProfitAmount    Int                  @map("net_profit_amount")
  taxProvisionAmount Int                  @default(0) @map("tax_provision_amount")
  reserveAllocations Json                 @map("reserve_allocations") @db.Json
  distributableAmount Int                 @map("distributable_amount")
  retainedAmount     Int                  @default(0) @map("retained_amount")
  status             AppropriationStatus  @default(draft)
  approvedBy         String?              @map("approved_by") @db.Uuid
  journalId          String?              @map("journal_id") @db.Uuid
  createdBy          String               @map("created_by") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  journal            JournalEntry?        @relation(fields: [journalId], references: [id])
  disbursements      ProfitDisbursement[]

  @@map("profit_appropriations")
}

model ProfitDisbursement {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appropriationId      String              @map("appropriation_id") @db.Uuid
  shareholderId        String              @map("shareholder_id") @db.Uuid
  sharePercentage      Decimal             @map("share_percentage") @db.Decimal(7, 4)
  grossAmount          Int                 @map("gross_amount")
  taxWithheldAmount    Int                 @default(0) @map("tax_withheld_amount")
  netAmount            Int                 @map("net_amount")
  voucherId            String?             @map("voucher_id") @db.Uuid
  paymentMethod        PaymentMethod?      @map("payment_method")
  paymentDate          DateTime?           @map("payment_date") @db.Date
  paymentReference     String?             @map("payment_reference")
  taxCertificateNumber String?             @map("tax_certificate_number")
  status               DisbursementStatus  @default(pending)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  appropriation        ProfitAppropriation @relation(fields: [appropriationId], references: [id])
  shareholder          Shareholder         @relation(fields: [shareholderId], references: [id])
  voucher              Voucher?            @relation(fields: [voucherId], references: [id])

  @@map("profit_disbursements")
}
