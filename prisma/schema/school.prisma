model AcademicYear {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  isCurrent Boolean            @default(false) @map("is_current")
  status    AcademicYearStatus @default(planning)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  terms                 AcademicTerm[]
  students              Student[]
  enrollments           StudentEnrollment[]
  admissionFeeSettings  AdmissionFeeSetting[]
  attendanceSettings    AttendanceSetting[]
  holidays              Holiday[]
  curricula             Curriculum[]
  iepPlans              IepPlan[]
  progressReports       ProgressReport[]
  feeStructures         FeeStructure[]
  feeInvoices           FeeInvoice[]

  @@map("academic_years")
}

model AcademicTerm {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  sequence       Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, sequence])
  @@map("academic_terms")
}

model Shift {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @unique
  startTime     DateTime @map("start_time") @db.Time(0)
  endTime       DateTime @map("end_time") @db.Time(0)
  capacityLimit Int?     @map("capacity_limit")
  breakStart    DateTime? @map("break_start") @db.Time(0)
  breakEnd      DateTime? @map("break_end") @db.Time(0)
  workingHours  Decimal? @map("working_hours") @db.Decimal(4, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  students              Student[]
  enrollments           StudentEnrollment[]
  teacherShiftAssignments TeacherShiftAssignment[]
  mappings              StudentTeacherMapping[]
  attendance            StudentAttendance[]

  @@map("shifts")
}

model Student {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentCode             String        @unique @map("student_code")
  fullName                String        @map("full_name")
  dateOfBirth             DateTime?     @map("date_of_birth") @db.Date
  gender                  String?
  nationality             String?
  religion                String?
  disabilityCategory      String?       @map("disability_category")
  disabilityCategoryHash  String?       @map("disability_category_hash")
  severityLevel           String?       @map("severity_level")
  bloodGroup              String?       @map("blood_group")
  photoAttachmentId       String?       @map("photo_attachment_id") @db.Uuid
  previousInstitution     String?       @map("previous_institution")
  previousTherapyHistory  String?       @map("previous_therapy_history")
  supportNeeds            String?       @map("support_needs")
  shiftId                 String?       @map("shift_id") @db.Uuid
  academicYearId          String?       @map("academic_year_id") @db.Uuid
  status                  StudentStatus @default(pending_admission_fee)
  statusReason            String?       @map("status_reason")
  admissionDate           DateTime?     @map("admission_date") @db.Date
  enrollmentDate          DateTime?     @map("enrollment_date") @db.Date
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  createdBy               String?       @map("created_by") @db.Uuid
  updatedBy               String?       @map("updated_by") @db.Uuid
  deletedAt               DateTime?     @map("deleted_at")

  shift          Shift?                 @relation(fields: [shiftId], references: [id])
  academicYear   AcademicYear?          @relation(fields: [academicYearId], references: [id])
  guardians      StudentGuardian[]
  documents      StudentDocument[]
  enrollments    StudentEnrollment[]
  statusHistory  StudentStatusHistory[]
  admissionFee   AdmissionFee?
  mappings       StudentTeacherMapping[]
  substitutes    SubstituteAssignment[]
  attendance     StudentAttendance[]
  iepPlans       IepPlan[]
  progressReports ProgressReport[]
  feeAssignments StudentFeeAssignment[]
  discounts      StudentDiscount[]
  scholarships   Scholarship[]
  feeInvoices    FeeInvoice[]
  feePayments    FeePayment[]
  medicalRecord  StudentMedicalRecord?
  immunizations  StudentImmunization[]
  medicalIncidents MedicalIncident[]
  behavioralIncidents BehavioralIncident[]
  behaviorSupportPlans BehaviorSupportPlan[]
  activityEnrollments ActivityEnrollment[]
  activityAttendance  ActivityAttendance[]
  leaveRequests  StudentLeaveRequest[]
  messageThreads PortalMessageThread[]
  portalMessages PortalMessage[]

  @@index([status])
  @@index([shiftId])
  @@index([academicYearId, status])
  @@index([disabilityCategoryHash])
  @@map("students")
}

model StudentStatusHistory {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String        @map("student_id") @db.Uuid
  fromStatus       StudentStatus @map("from_status")
  toStatus         StudentStatus @map("to_status")
  reason           String?
  changedBy        String        @map("changed_by") @db.Uuid
  changedAt        DateTime      @default(now()) @map("changed_at")
  isManualOverride Boolean       @default(false) @map("is_manual_override")

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, changedAt])
  @@map("student_status_history")
}

model StudentGuardian {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId           String  @map("student_id") @db.Uuid
  guardianProfileId   String? @map("guardian_profile_id") @db.Uuid
  fullName            String  @map("full_name")
  relation            String
  phone               String?
  email               String?
  occupation          String?
  nationalId          String? @map("national_id")
  address             String?
  isPrimary           Boolean @default(false) @map("is_primary")
  isEmergencyContact  Boolean @default(false) @map("is_emergency_contact")
  emergencyPriority   Int?    @map("emergency_priority")
  portalAccessEnabled Boolean @default(false) @map("portal_access_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianProfile GuardianProfile? @relation(fields: [guardianProfileId], references: [id])

  @@index([studentId])
  @@index([guardianProfileId])
  @@map("student_guardians")
}

model StudentDocument {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String              @map("student_id") @db.Uuid
  documentType StudentDocumentType @map("document_type")
  attachmentId String              @map("attachment_id") @db.Uuid
  issuedDate   DateTime?           @map("issued_date") @db.Date
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

model StudentEnrollment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  shiftId        String           @map("shift_id") @db.Uuid
  enrollmentDate DateTime         @map("enrollment_date") @db.Date
  status         EnrollmentStatus @default(enrolled)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  shift        Shift        @relation(fields: [shiftId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("student_enrollments")
}

model AdmissionFeeSetting {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYearId  String   @map("academic_year_id") @db.Uuid
  studentCategory String?  @map("student_category")
  amount          Int
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, studentCategory])
  @@map("admission_fee_settings")
}

model AdmissionFee {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String             @unique @map("student_id") @db.Uuid
  amount           Int
  status           AdmissionFeeStatus @default(pending)
  invoiceDate      DateTime           @map("invoice_date") @db.Date
  paidDate         DateTime?          @map("paid_date") @db.Date
  paidAmount       Int?               @map("paid_amount")
  paymentMethod    PaymentMethod?     @map("payment_method")
  paymentReference String?            @map("payment_reference")
  receiptNumber    String?            @map("receipt_number")
  recordedBy       String?            @map("recorded_by") @db.Uuid
  attachmentId     String?            @map("attachment_id") @db.Uuid
  waiverApprovedBy String?            @map("waiver_approved_by") @db.Uuid
  waiverReason     String?            @map("waiver_reason")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])

  @@map("admission_fees")
}

model Teacher {
  id                         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                 String         @unique @map("employee_id") @db.Uuid
  specializationAreas        String[]       @map("specialization_areas")
  teachingMethodology        String?        @map("teaching_methodology")
  yearsExperienceSpecialNeeds Int?          @map("years_experience_special_needs")
  status                     TeacherStatus  @default(active)
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  employee        Employee                 @relation(fields: [employeeId], references: [id])
  certifications  TeacherCertification[]
  shiftAssignments TeacherShiftAssignment[]
  activitySupervisions ActivitySupervisor[]

  @@map("teachers")
}

model TeacherCertification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId    String    @map("teacher_id") @db.Uuid
  title        String
  issuingBody  String    @map("issuing_body")
  issuedDate   DateTime? @map("issued_date") @db.Date
  expiryDate   DateTime? @map("expiry_date") @db.Date
  attachmentId String?   @map("attachment_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_certifications")
}

model TeacherShiftAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId     String    @map("teacher_id") @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  teacher Teacher @relation(fields: [teacherId], references: [id])
  shift   Shift   @relation(fields: [shiftId], references: [id])

  @@index([teacherId, shiftId])
  @@map("teacher_shift_assignments")
}

model StudentTeacherMapping {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  teacherEmployeeId String    @map("teacher_employee_id") @db.Uuid
  shiftId           String    @map("shift_id") @db.Uuid
  mappingType       String    @default("primary") @map("mapping_type")
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  isActive          Boolean   @default(true) @map("is_active")
  createdReason     String?   @map("created_reason")
  endedReason       String?   @map("ended_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  student         Student  @relation(fields: [studentId], references: [id])
  teacherEmployee Employee @relation("MappingTeacher", fields: [teacherEmployeeId], references: [id])
  shift           Shift    @relation(fields: [shiftId], references: [id])

  @@index([teacherEmployeeId, isActive])
  @@index([studentId, isActive])
  @@map("student_teacher_mappings")
}

model SubstituteAssignment {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String           @map("student_id") @db.Uuid
  primaryTeacherId     String           @map("primary_teacher_id") @db.Uuid
  substituteTeacherId  String?          @map("substitute_teacher_id") @db.Uuid
  startDate            DateTime         @map("start_date") @db.Date
  endDate              DateTime         @map("end_date") @db.Date
  triggerType          SubstituteTrigger @map("trigger_type")
  triggerReferenceId   String           @map("trigger_reference_id") @db.Uuid
  status               SubstituteStatus @default(pending)
  assignedBy           String?          @map("assigned_by") @db.Uuid
  revertedAt           DateTime?        @map("reverted_at")
  notes                String?
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  student           Student  @relation(fields: [studentId], references: [id])
  primaryTeacher    Employee @relation("SubPrimary", fields: [primaryTeacherId], references: [id])
  substituteTeacher Employee? @relation("SubCover", fields: [substituteTeacherId], references: [id])

  @@unique([studentId, triggerType, triggerReferenceId])
  @@index([startDate, endDate])
  @@index([substituteTeacherId, startDate])
  @@map("substitute_assignments")
}

model StudentAttendance {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId           String                  @map("student_id") @db.Uuid
  attendanceDate      DateTime                @map("attendance_date") @db.Date
  shiftId             String                  @map("shift_id") @db.Uuid
  status              StudentAttendanceStatus
  remarks             String?
  markedBy            String?                 @map("marked_by") @db.Uuid
  markedAt            DateTime?               @map("marked_at")
  isAmended           Boolean                 @default(false) @map("is_amended")
  amendedBy           String?                 @map("amended_by") @db.Uuid
  amendedAt           DateTime?               @map("amended_at")
  amendmentReason     String?                 @map("amendment_reason")
  amendmentApprovedBy String?                 @map("amendment_approved_by") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  student    Student               @relation(fields: [studentId], references: [id])
  shift      Shift                 @relation(fields: [shiftId], references: [id])
  amendments AttendanceAmendment[]

  @@unique([studentId, attendanceDate])
  @@index([attendanceDate])
  @@index([shiftId, attendanceDate])
  @@map("student_attendance")
}

model AttendanceAmendment {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceId    String           @map("attendance_id") @db.Uuid
  previousStatus  StudentAttendanceStatus @map("previous_status")
  requestedStatus StudentAttendanceStatus @map("requested_status")
  reason          String
  requestedBy     String           @map("requested_by") @db.Uuid
  status          AmendmentStatus  @default(pending)
  reviewedBy      String?          @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?        @map("reviewed_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  attendance StudentAttendance @relation(fields: [attendanceId], references: [id])

  @@index([attendanceId])
  @@map("attendance_amendments")
}

model AttendanceSetting {
  id                              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYearId                  String  @map("academic_year_id") @db.Uuid
  freezeAfterDays                 Int     @default(7) @map("freeze_after_days")
  allowTeacherMarking             Boolean @default(true) @map("allow_teacher_marking")
  unauthorizedAbsenceAlertEnabled  Boolean @default(true) @map("unauthorized_absence_alert_enabled")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId])
  @@map("attendance_settings")
}
