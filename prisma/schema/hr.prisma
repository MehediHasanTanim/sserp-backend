model Employee {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode       String         @unique @map("employee_code")
  fullName           String         @map("full_name")
  dateOfBirth        DateTime?      @map("date_of_birth") @db.Date
  gender             String?
  nationalId         String?        @map("national_id")
  personalEmail      String?        @map("personal_email")
  phone              String?
  address            Json?
  photoAttachmentId  String?        @map("photo_attachment_id") @db.Uuid
  department         HrDepartment
  designation        String
  employmentType     EmploymentType @map("employment_type")
  reportingManagerId String?        @map("reporting_manager_id") @db.Uuid
  joiningDate        DateTime       @map("joining_date") @db.Date
  probationEndDate   DateTime?      @map("probation_end_date") @db.Date
  confirmationDate   DateTime?      @map("confirmation_date") @db.Date
  basicSalary        Int            @map("basic_salary")
  status             EmployeeStatus @default(on_probation)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  createdBy          String?        @map("created_by") @db.Uuid
  updatedBy          String?        @map("updated_by") @db.Uuid
  deletedAt          DateTime?      @map("deleted_at")

  reportingManager Employee?  @relation("EmployeeManager", fields: [reportingManagerId], references: [id])
  directReports    Employee[] @relation("EmployeeManager")
  user             User?
  contracts        EmployeeContract[]
  documents        EmployeeDocument[]
  history          EmployeeHistory[]
  exit             EmployeeExit?
  shiftAssignments EmployeeShiftAssignment[]
  attendance       HrAttendance[]
  leaveBalances    LeaveBalance[]
  leaveRequests    HrLeaveRequest[]
  teacherProfile   Teacher?

  mappingsAsTeacher     StudentTeacherMapping[] @relation("MappingTeacher")
  substitutesAsPrimary  SubstituteAssignment[]  @relation("SubPrimary")
  substitutesAsCover    SubstituteAssignment[]  @relation("SubCover")

  @@index([department, status])
  @@map("employees")
}

model EmployeeContract {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  contractType String    @map("contract_type")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  attachmentId String?   @map("attachment_id") @db.Uuid
  isCurrent    Boolean   @default(true) @map("is_current")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("employee_contracts")
}

model EmployeeDocument {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String               @map("employee_id") @db.Uuid
  documentType EmployeeDocumentType @map("document_type")
  attachmentId String               @map("attachment_id") @db.Uuid
  issuedDate   DateTime?            @map("issued_date") @db.Date
  expiryDate   DateTime?            @map("expiry_date") @db.Date
  notes        String?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("employee_documents")
}

model EmployeeHistory {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String              @map("employee_id") @db.Uuid
  changeType    EmployeeChangeType  @map("change_type")
  effectiveDate DateTime            @map("effective_date") @db.Date
  fromValue     Json?               @map("from_value")
  toValue       Json?               @map("to_value")
  reason        String?
  recordedBy    String              @map("recorded_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("employee_history")
}

model EmployeeExit {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId           String     @unique @map("employee_id") @db.Uuid
  exitType             ExitType   @map("exit_type")
  noticeDate           DateTime   @map("notice_date") @db.Date
  lastWorkingDay       DateTime   @map("last_working_day") @db.Date
  exitInterviewNotes   String?    @map("exit_interview_notes")
  clearanceChecklist   Json?      @map("clearance_checklist")
  status               ExitStatus @default(in_progress)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_exits")
}

model HrShift {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  startTime    DateTime @map("start_time") @db.Time(0)
  endTime      DateTime @map("end_time") @db.Time(0)
  graceMinutes Int      @default(15) @map("grace_minutes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignments EmployeeShiftAssignment[]

  @@map("hr_shifts")
}

model EmployeeShiftAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  hrShiftId     String    @map("hr_shift_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  hrShift  HrShift  @relation(fields: [hrShiftId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("employee_shift_assignments")
}

model HrAttendance {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String             @map("employee_id") @db.Uuid
  attendanceDate  DateTime           @map("attendance_date") @db.Date
  status          HrAttendanceStatus
  checkIn         DateTime?          @map("check_in")
  checkOut        DateTime?          @map("check_out")
  overtimeMinutes Int                @default(0) @map("overtime_minutes")
  lateMinutes     Int                @default(0) @map("late_minutes")
  source          AttendanceSource   @default(manual)
  remarks         String?
  markedBy        String?            @map("marked_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate, status])
  @@map("hr_attendance")
}

model LeaveType {
  id                                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                               String   @unique
  name                               String
  isPaid                             Boolean  @default(true) @map("is_paid")
  annualEntitlementDays              Decimal  @map("annual_entitlement_days") @db.Decimal(5, 2)
  carryForwardAllowed                Boolean  @default(false) @map("carry_forward_allowed")
  maxCarryForwardDays                Decimal  @default(0) @map("max_carry_forward_days") @db.Decimal(5, 2)
  requiresMedicalCertificateAfterDays Int?    @map("requires_medical_certificate_after_days")
  isEncashable                       Boolean  @default(false) @map("is_encashable")
  maxEncashableDaysPerYear           Decimal? @map("max_encashable_days_per_year") @db.Decimal(5, 2)
  minBalanceToRetain                 Decimal  @default(0) @map("min_balance_to_retain") @db.Decimal(5, 2)
  appliesToEmploymentTypes           String[] @map("applies_to_employment_types")
  isActive                           Boolean  @default(true) @map("is_active")
  createdAt                          DateTime @default(now()) @map("created_at")
  updatedAt                          DateTime @updatedAt @map("updated_at")

  balances LeaveBalance[]
  requests HrLeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId         String  @map("employee_id") @db.Uuid
  leaveTypeId        String  @map("leave_type_id") @db.Uuid
  year               Int
  entitledDays       Decimal @map("entitled_days") @db.Decimal(5, 2)
  carriedForwardDays Decimal @default(0) @map("carried_forward_days") @db.Decimal(5, 2)
  consumedDays       Decimal @default(0) @map("consumed_days") @db.Decimal(5, 2)
  encashedDays       Decimal @default(0) @map("encashed_days") @db.Decimal(5, 2)
  pendingDays        Decimal @default(0) @map("pending_days") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model HrLeaveRequest {
  id                            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                    String            @map("employee_id") @db.Uuid
  leaveTypeId                   String            @map("leave_type_id") @db.Uuid
  startDate                     DateTime          @map("start_date") @db.Date
  endDate                       DateTime          @map("end_date") @db.Date
  totalDays                     Decimal           @map("total_days") @db.Decimal(5, 2)
  isHalfDay                     Boolean           @default(false) @map("is_half_day")
  reason                        String?
  medicalCertificateAttachmentId String?          @map("medical_certificate_attachment_id") @db.Uuid
  status                        LeaveRequestStatus @default(pending)
  currentApprovalLevel          Int               @default(1) @map("current_approval_level")
  rejectedReason                String?           @map("rejected_reason")
  approvedBy                    String?           @map("approved_by") @db.Uuid
  approvedAt                    DateTime?         @map("approved_at")
  cancelledAt                   DateTime?         @map("cancelled_at")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")

  employee      Employee             @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType            @relation(fields: [leaveTypeId], references: [id])
  approvalSteps LeaveApprovalStep[]

  @@index([employeeId, status])
  @@index([startDate, endDate, status])
  @@map("hr_leave_requests")
}

model LeaveApprovalStep {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaveRequestId String          @map("leave_request_id") @db.Uuid
  level          Int
  approverRole   String          @map("approver_role")
  approverUserId String?         @map("approver_user_id") @db.Uuid
  decision       ApprovalDecision @default(pending)
  decidedAt      DateTime?       @map("decided_at")
  comment        String?
  createdAt      DateTime        @default(now()) @map("created_at")

  leaveRequest HrLeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, level])
  @@map("leave_approval_steps")
}

model Holiday {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  holidayDate          DateTime    @map("holiday_date") @db.Date
  type                 HolidayType
  academicYearId       String?     @map("academic_year_id") @db.Uuid
  appliesToDepartments String[]    @map("applies_to_departments")
  description          String?
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([holidayDate, type])
  @@index([holidayDate])
  @@map("holidays")
}
