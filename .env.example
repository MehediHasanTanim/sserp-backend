NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

DATABASE_URL=postgresql://sserp:sserp@localhost:55432/sserp?schema=public
DATABASE_APP_URL=postgresql://sserp_app:sserp_app@localhost:55432/sserp?schema=public
REDIS_URL=redis://localhost:6379

JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_COST=12
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# -----------------------------------------------------------------------------
# Cloudflare R2 — one physical bucket; folders via object-key prefix
# Create a single bucket (e.g. sserp). API `bucket` values map to folders:
#   student-documents/, iep-documents/, progress-reports/, therapy-attachments/,
#   hr-documents/, invoices-receipts/, activity-media/, leave-documents/, exports/
# Endpoint is built as: {R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=<ACCOUNT_ID>
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=sserp
R2_PUBLIC_URL=https://<your-public-r2-or-cdn-host>
PRESIGN_TTL_SECONDS=900

# Optional overrides (local MinIO / custom endpoint):
# R2_ENDPOINT=localhost
# R2_PORT=9000
# R2_USE_SSL=false

SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=console

CORS_ORIGINS=http://localhost:3001
BOOTSTRAP_ADMIN_EMAIL=admin@sserp.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow1
BOOTSTRAP_ADMIN_USERNAME=superadmin

SENTRY_DSN=
FIELD_ENCRYPTION_MASTER_KEY=
BLIND_INDEX_KEY=
FEATURE_BIOMETRIC=false
FEATURE_PAYMENT_GATEWAY=false
LOG_LEVEL=debug

COOKIE_SECURE=false

PUPPETEER_EXECUTABLE_PATH=
PDF_CONCURRENCY=2
