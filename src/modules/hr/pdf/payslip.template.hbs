<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Payslip {{slip.slipNumber}}</title>
  <style>
    body { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #1a1a1a; }
    h1 { font-size: 18px; margin-bottom: 4px; }
    table { width: 100%; border-collapse: collapse; margin-top: 12px; }
    th, td { border: 1px solid #ccc; padding: 6px; text-align: left; font-size: 11px; }
    .totals { margin-top: 12px; text-align: right; }
    .meta { margin-bottom: 8px; }
  </style>
</head>
<body>
  <h1>Payslip {{slip.slipNumber}}</h1>
  <div class="meta">
    Employee: {{employee.fullName}} ({{employee.employeeCode}})<br />
    Period: {{payrollRun.periodMonth}}/{{payrollRun.periodYear}} — Run #{{payrollRun.runNumber}}<br />
    Working days: {{slip.workingDays}} · Present: {{slip.presentDays}} · LOP: {{slip.lopDays}}
  </div>

  <table>
    <thead>
      <tr><th>Component</th><th>Type</th><th>Amount</th></tr>
    </thead>
    <tbody>
      {{#each slip.lines}}
      <tr>
        <td>{{componentName}}</td>
        <td>{{componentType}}</td>
        <td>{{amount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="totals">
    Gross: {{slip.grossAmount}}<br />
    Deductions: {{slip.totalDeductions}}<br />
    <strong>Net: {{slip.netAmount}}</strong>
  </div>
</body>
</html>
