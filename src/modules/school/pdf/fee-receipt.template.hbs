<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Receipt {{payment.receiptNumber}}</title>
  <style>
    body { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #1a1a1a; }
    h1 { font-size: 18px; margin-bottom: 4px; }
    .box { border: 1px solid #ccc; padding: 12px; margin-top: 12px; }
  </style>
</head>
<body>
  <h1>Payment Receipt {{payment.receiptNumber}}</h1>
  <div class="box">
    Student: {{student.fullName}} ({{student.studentCode}})<br />
    Invoice: {{invoice.invoiceNumber}}<br />
    Amount: {{payment.amount}}<br />
    Method: {{payment.method}}<br />
    Payment date: {{payment.paymentDate}}<br />
    Status: {{payment.status}}
  </div>
</body>
</html>
